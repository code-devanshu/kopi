{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kopi",
  "version": "../package.json",
  "identifier": "in.devanshuverma.kopi",
  "build": {
    "beforeDevCommand": "pnpm dev:ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:ui",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: kopi: http://kopi.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "copyright": "© 2026 Devanshu Verma",
    "shortDescription": "A fast, private clipboard manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 428 },
        "appPosition": { "x": 170, "y": 155 },
        "applicationFolderPosition": { "x": 490, "y": 155 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5RDIzRTMzRTM1NTQyNjEKUldSaFFsWGpNejdTbVQrMFJ0ZzA1djVKS2ZRUDUzQUYxVUdhR2ZEZHozaGpvVUZzT2sxdDZWeHAK",
      "endpoints": ["https://github.com/code-devanshu/kopi/releases/download/updater/latest.json"],
      "requireSignedVersion": true
    }
  }
}
